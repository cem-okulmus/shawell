@prefix ex: <http://datashapes.org/sh/tests/core/property/equals-path-001.test#> .
@prefix mf: <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix sht: <http://www.w3.org/ns/shacl-test#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Shape: sh:path ex:property1 ; sh:equals [ sh:inversePath ex:property2 ]
# Constraint: {values via property1} == {nodes that point to focus node via property2}

ex:TestShape
  rdf:type sh:NodeShape ;
  sh:property ex:TestShape-property1 ;
  sh:targetNode ex:ValidResource1 ;
  sh:targetNode ex:InvalidResource1 ;
  sh:targetNode ex:InvalidResource2 ;
.
ex:TestShape-property1
  sh:path ex:property1 ;
  sh:equals [ sh:inversePath ex:property2 ] ;
.

# ValidResource1: property1 = {ex:Value1}, ^property2 = {ex:Value1} → equal
ex:ValidResource1
  ex:property1 ex:Value1 ;
.
ex:Value1 ex:property2 ex:ValidResource1 .

# InvalidResource1: property1 = {ex:Value1}, ^property2 = {ex:Value1, ex:Value2}
# ex:Value2 is in ^property2 but not in property1 → violation, sh:value ex:Value2
ex:InvalidResource1
  ex:property1 ex:Value1 ;
.
ex:Value1 ex:property2 ex:InvalidResource1 .
ex:Value2 ex:property2 ex:InvalidResource1 .

# InvalidResource2: property1 = {ex:Value1, ex:Value2}, ^property2 = {ex:Value1}
# ex:Value2 is in property1 but not in ^property2 → violation, sh:value ex:Value2
ex:InvalidResource2
  ex:property1 ex:Value1 ;
  ex:property1 ex:Value2 ;
.
ex:Value1 ex:property2 ex:InvalidResource2 .

<>
  rdf:type mf:Manifest ;
  mf:entries (
      <equals-path-001>
    ) ;
.
<equals-path-001>
  rdf:type sht:Validate ;
  rdfs:label "Test of sh:equals with inverse path argument at property shape 001" ;
  mf:action [
      sht:dataGraph <> ;
      sht:shapesGraph <> ;
    ] ;
  mf:result [
      rdf:type sh:ValidationReport ;
      sh:conforms "false"^^xsd:boolean ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode ex:InvalidResource1 ;
          sh:resultPath ex:property1 ;
          sh:resultSeverity sh:Violation ;
          sh:sourceConstraintComponent sh:EqualsConstraintComponent ;
          sh:sourceShape ex:TestShape-property1 ;
          sh:value ex:Value2 ;
        ] ;
      sh:result [
          rdf:type sh:ValidationResult ;
          sh:focusNode ex:InvalidResource2 ;
          sh:resultPath ex:property1 ;
          sh:resultSeverity sh:Violation ;
          sh:sourceConstraintComponent sh:EqualsConstraintComponent ;
          sh:sourceShape ex:TestShape-property1 ;
          sh:value ex:Value2 ;
        ] ;
    ] ;
  mf:status sht:approved ;
.
